{
  "$schema": "https://raw.githubusercontent.com/Axenide/Ambxst/dev/docs/mods/manifest.schema.json",
  "manifestVersion": 1,
  "id": "mnojz.ambxstytd",
  "name": "Ambxst YTD",
  "version": "1.4.4",
  "description": "Download YouTube audio and video from an Ambxst bar popup.",
  "license": "MIT",
  "author": "mnojz",
  "compatibility": {
    "api": 1,
    "ambxst": ">=1.3.0 <1.4.0",
    "testedBaseCommits": ["2a704c438ddc0b94a11f4e4cf32a16220b62141f"]
  },
  "commands": ["python3", "yt-dlp", "ffmpeg", "wl-paste", "xdg-open"],
  "permissions": [
    "Runs yt-dlp and ffmpeg to download media from a user-provided URL",
    "Writes audio to ~/Music and video to ~/Videos",
    "Stores up to 40 download history entries in Ambxst state",
    "Opens completed download folders"
  ],
  "operations": [
    { "type": "overlay", "source": "payload/modules/services/YtdService.qml", "target": "modules/services/YtdService.qml" },
    { "type": "overlay", "source": "payload/modules/services/YtdI18n.qml", "target": "modules/services/YtdI18n.qml" },
    { "type": "overlay", "source": "payload/modules/services/YtdHistory.js", "target": "modules/services/YtdHistory.js" },
    { "type": "overlay", "source": "payload/modules/services/YtdUrl.js", "target": "modules/services/YtdUrl.js" },
    { "type": "overlay", "source": "payload/modules/bar/YtdButton.qml", "target": "modules/bar/YtdButton.qml" },
    { "type": "overlay", "source": "payload/scripts/ytd_helper.py", "target": "modules/bar/ytd_helper.py" },
    { "type": "overlay", "source": "payload/assets/ytd.svg", "target": "modules/bar/ytd.svg" },
    { "type": "patch", "source": "patches/bar.patch" }
  ]
}